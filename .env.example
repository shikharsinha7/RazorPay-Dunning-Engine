# Get these from your Supabase project:
# Project Settings -> Database -> Connection string -> URI
# Use the "Session pooler" connection (port 5432), not the "Transaction pooler" (6543) —
# Hibernate's DDL auto-update needs prepared statement support the transaction pooler doesn't give cleanly.

SPRING_DATASOURCE_URL=jdbc:postgresql://<YOUR_SUPABASE_HOST>:5432/postgres
SPRING_DATASOURCE_USERNAME=postgres.<YOUR_PROJECT_REF>
SPRING_DATASOURCE_PASSWORD=<YOUR_DB_PASSWORD>

# Get a free key at https://aistudio.google.com -> "Get API key". No billing needed for the free tier.
GEMINI_API_KEY=

# Get a free key at https://resend.com -> API Keys. Free tier: 100 emails/day, 3,000/month.
# No domain verification needed — sending from onboarding@resend.dev works out of the box.
RESEND_API_KEY=
